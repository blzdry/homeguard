# Window Rule configurations go here

default_border pixel 4
for_window [class=.*] border pixel 4
for_window [all] title_format " "
focus_on_window_activation urgent
focus_follows_mouse no

# Assign programs onto their specific workspaces

assign [class="Alacritty"]  "1:[SYSTEM]"
assign [class="Navigator"]  "2:[INTERNET]"
assign [class="Thunar"]     "3:[LOCAL]"
