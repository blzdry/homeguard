# My configuration file for i3wm

# Default Settings

set $mod Mod4
font pango: MartianMonoNerdFont Semi-Bold 9
set $refresh_i3status killall -SIGUSR1 i3status
floating_modifier $mod
tiling_drag modifier titlebar

# Source file configurations inside the folder
include $HOME/.config/i3/sources/001_autoStart
include $HOME/.config/i3/sources/002_keyBinds
include $HOME/.config/i3/sources/003_windowRules
include $HOME/.config/i3/sources/004_statusBar
include $HOME/.config/i3/sources/005_scriptStart
